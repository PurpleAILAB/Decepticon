# NEXT_PUBLIC_DECEPTICON_EDITION=ee
# GITHUB_ID=""
# GITHUB_SECRET=""
# AUTH_SECRET=""        # Generate with: npx auth secret
# AUTH_URL="http://localhost:3000"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
