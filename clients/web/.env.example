# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://decepticon:decepticon@localhost:5432/decepticon_web"

# ── LangGraph Server ─────────────────────────────────────────────────
LANGGRAPH_API_URL="http://localhost:2024"

# ── Neo4j (attack graph visualization) ───────────────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# ── EE / SaaS mode (ignore for OSS self-hosted) ─────────────────────
